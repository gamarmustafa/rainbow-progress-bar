<idea-plugin>
    <id>io.almabaw.progressbar</id>
    <name>Rainbow Progress Bar</name>
    <vendor email="qemerrr@gmail.com">qemerrr</vendor>

    <description><![CDATA[
        Your progress bars are grey. Grey! Fix that: this plugin repaints
        every progress bar as a smoothly scrolling rainbow with quirky
        one-liners marching across it &mdash; <i>SUMMONING BYTES</i>,
        <i>DOWNLOADING MORE RAM</i>, <i>ALMOST THERE (TOTALLY LYING)</i>...
        <br/><br/>
        Indexing, Gradle sync, the status bar, dialogs &mdash; wherever the
        IDE makes you wait, at least now the wait is fabulous.
        <br/><br/>
        Not feeling our jokes? Write your own! Every phrase is editable in
        <b>Settings &gt; Appearance &amp; Behavior &gt; Rainbow Progress
        Bar</b>.
    ]]></description>

    <!-- Works in any IntelliJ-based IDE (Android Studio, IDEA, etc.) -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="appearance"
            id="com.example.rainbow.settings"
            displayName="Rainbow Progress Bar"
            instance="com.example.rainbow.RainbowSettingsConfigurable"/>
    </extensions>

    <applicationListeners>
        <!-- Install the rainbow UI once the IDE frame exists. -->
        <listener
            class="com.example.rainbow.RainbowProgressBarActivator"
            topic="com.intellij.ide.AppLifecycleListener"/>
        <!-- A theme / Look-and-Feel switch resets ProgressBarUI to the platform
             default, so re-apply ours whenever the LaF changes. -->
        <listener
            class="com.example.rainbow.RainbowProgressBarActivator"
            topic="com.intellij.ide.ui.LafManagerListener"/>
    </applicationListeners>
</idea-plugin>
